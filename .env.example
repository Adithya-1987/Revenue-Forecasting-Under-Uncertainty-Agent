# Copy to .env and fill in. Never commit .env.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
VITE_API_URL=/api
VITE_USE_MOCK=false
# Server only (never prefix with VITE_)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Aczen Nova: read-only accounting data API (pipeline sync). NOVA_WORKSPACES = workspace ids allowed to use this key
NOVA_API_KEY=
NOVA_BASE_URL=https://www.aczen.in/nova-api/v1
NOVA_WORKSPACES=
# Gemini key pool, comma-separated; rotated on rate limits
GEMINI_API_KEYS=
GEMINI_RPM=10
GEMINI_MODEL=
# ElevenLabs voice agent
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
